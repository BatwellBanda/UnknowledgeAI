DATABASE_URL=postgresql+psycopg2://uniknowledge_user:replace_with_database_password@localhost:5432/uniknowledge_db
SECRET_KEY=replace_with_a_random_secret_generated_as_described_in_README
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=768
# Optional hardening settings (defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_USER_STORAGE_MB=500
EXTRACTION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_EMBEDDINGS=4
BUSY_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
# Enable only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
