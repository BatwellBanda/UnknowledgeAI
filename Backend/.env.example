DATABASE_URL=postgresql+psycopg2://uniknowledge_user:replace_with_database_password@localhost:5432/uniknowledge_db
SECRET_KEY=replace_with_a_random_secret_generated_as_described_in_README
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=768
# Optional hardening settings (defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_USER_STORAGE_MB=500
EXTRACTION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_EMBEDDINGS=4
BUSY_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
# Lecture recordings (FFmpeg and FFprobe must be installed and on PATH, or give full paths).
MAX_RECORDING_MB=200
MAX_RECORDING_MINUTES=180
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# "whisper" transcribes recordings locally (the model downloads on first use); "disabled" requires caption files.
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL=openai/whisper-base
TRANSCRIPTION_LANGUAGE=english
MEDIA_LINK_MINUTES=120
# Enable only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
